{
  "name": "smart-skillgap-root",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Skill Gap & Career Roadmap Platform",
  "scripts": {
    "build": "cd server && npm install && cd ../client && npm install && npm run build",
